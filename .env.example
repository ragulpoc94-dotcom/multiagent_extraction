# Copy to .env (never commit .env). One Groq key is used for all three models.
GROQ_API_KEY=
MODEL_1=
MODEL_2=
MODEL_3=

# Optional tuning (defaults shown)
# MAX_CONCURRENCY=3          # concurrent Groq requests across the 9 cells
# MAX_RETRIES=5              # retries for 429 / 5xx / timeouts (exponential backoff)
# REQUESTS_PER_MINUTE=30     # client-side RPM limiter; set to your Groq tier
# MAX_DOCUMENT_TOKENS=6000   # per-call document budget; longer documents are chunked by page
# MAX_OUTPUT_TOKENS=4096
# OCR_LANGUAGE=eng
# CORS_ORIGINS=http://localhost:5173
# DATA_DIR=./backend/data
